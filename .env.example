# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=5001
# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://doctor-tracker-frontend-alpha.vercel.app

# ==========================================
# Database Configuration (MongoDB)
# ==========================================
# Local MongoDB or MongoDB Atlas connection string
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/doctor_tracker?retryWrites=true&w=majority

# ==========================================
# Admin Seeding Credentials
# ==========================================
ADMIN_NAME="System Admin"
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=Admin@123456

# ==========================================
# Redis Configuration (Currently Disabled)
# ==========================================
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ==========================================
# JWT Authentication Secrets & Expirations
# ==========================================
# Tip: Generate strong 64-byte hex secrets in terminal using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_64_byte_hex_access_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_64_byte_hex_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=365d

# ==========================================
# SMTP Configuration (Nodemailer / OTP Email)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_google_app_password
SMTP_FROM="Doctor Tracker <your_email@gmail.com>"

# ==========================================
# Cloudinary Configuration (Media / Uploads)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEYS=your_cloudinary_api_key
CLOUDINARY_SECRET_KEYS=your_cloudinary_api_secret

# ==========================================
# Security & Logging
# ==========================================
BCRYPT_SALT_ROUNDS=12
# Options: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
